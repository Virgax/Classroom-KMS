# =====================================================================
# Classroom - LMS by Airlink
# Plantilla de variables de entorno.
#
#   cp .env.example .env    y llenar los valores reales.
#
# .env esta en .gitignore y NUNCA se commitea.
# En produccion estos valores vienen de Azure Key Vault, no de un
# archivo en disco.
# =====================================================================

# ── Base de datos del LMS ──────────────────────────────────────────────
# Nota: puerto no estandar (13999). Formato SQL Server: host,puerto
LMS_DB_SERVER=192.168.181.248,13999
LMS_DB_NAME=AIRLINK_LMS

# Principal de aplicacion. SOLO tiene EXECUTE sobre stored procedures:
# cero SELECT/INSERT/UPDATE/DELETE directo sobre tablas. Ver 00_setup_database_roles.sql
LMS_DB_USER=AlLmsAppUser
LMS_DB_PASSWORD=<<REEMPLAZAR-DESDE-KEY-VAULT-APPUSER>>

# Principal de sincronizacion. Lee SPN y AIRLINK, escribe en el esquema intg.
LMS_SYNC_DB_USER=AlLmsSyncUser
LMS_SYNC_DB_PASSWORD=<<REEMPLAZAR-DESDE-KEY-VAULT-SYNCUSER>>

# Principal de reportes. SELECT unicamente sobre el esquema rpt.
LMS_REPORT_DB_USER=AlLmsReportUser
LMS_REPORT_DB_PASSWORD=<<REEMPLAZAR-DESDE-KEY-VAULT-REPORTUSER>>

# ── Bases de origen (SOLO LECTURA) ─────────────────────────────────────
# El LMS jamas escribe en estas. Si alguna vez hace falta, la respuesta
# es no.
SPN_DB_SERVER=192.168.181.248,13999
SPN_DB_NAME=SPN
AIRLINK_DB_SERVER=192.168.181.248,13999
AIRLINK_DB_NAME=AIRLINK

# ── Microsoft Entra ID ─────────────────────────────────────────────────
ENTRA_TENANT_ID=<<TENANT-ID>>
ENTRA_CLIENT_ID=<<APP-REGISTRATION-CLIENT-ID>>
ENTRA_CLIENT_SECRET=<<REEMPLAZAR-DESDE-KEY-VAULT-ENTRA>>
ENTRA_AUTHORITY=https://login.microsoftonline.com/<<TENANT-ID>>

# ── API ────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
API_BASE_URL=https://localhost:7001
API_CORS_ORIGINS=http://localhost:5173,https://localhost:5173

# Firma de tokens de sesion de kiosco. Minimo 32 bytes aleatorios.
JWT_SIGNING_KEY=<<REEMPLAZAR-CLAVE-ALEATORIA-32-BYTES>>
JWT_ISSUER=classroom.airlink.do
JWT_AUDIENCE=classroom-api

# ── Almacenamiento de archivos ─────────────────────────────────────────
# 1=FileShare  2=AzureBlob  3=S3
FILE_STORAGE_PROVIDER=1
FILE_STORAGE_PATH=\\\\airlink-fs01\\classroom\\uploads
FILE_MAX_SIZE_MB=200

# ── Notificaciones ─────────────────────────────────────────────────────
# El envio lo hace el worker de la API con Graph, no SQL Server.
GRAPH_SENDER_ADDRESS=classroom@airlink.com.do
TEAMS_WEBHOOK_URL=

# ── Frontend ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://localhost:7001
VITE_DEFAULT_LOCALE=es-DO
